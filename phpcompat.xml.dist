<?xml version="1.0"?>
<ruleset name="Presenter PHP compatibility">
	<description>PHP 8.3 and newer compatibility checks for Presenter.</description>

	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg name="extensions" value="php" />
	<arg value="sp" />

	<file>presenter.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>tests/php</file>
	<file>tools/headless</file>
	<file>tools/migration</file>
	<file>tools/snapshot</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="PHPCompatibilityWP" />
	<config name="testVersion" value="8.3-" />
</ruleset>
