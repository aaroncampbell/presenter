{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "presenter/slide",
	"version": "2.0.0",
	"title": "Presenter Slide",
	"category": "design",
	"icon": "slides",
	"description": "A single Reveal.js slide containing native WordPress blocks.",
	"textdomain": "presenter",
	"parent": [ "presenter/deck" ],
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		},
		"revealDataAttributes": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"value": { "type": "string" }
				}
			}
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"hidden": {
			"type": "boolean",
			"default": false
		},
		"notes": {
			"type": "string",
			"default": ""
		},
		"notesFormat": {
			"type": "string",
			"enum": [ "plain", "markdown" ],
			"default": "plain"
		},
		"transition": {
			"type": "string",
			"enum": [ "", "none", "fade", "slide", "convex", "concave", "zoom" ],
			"default": ""
		},
		"backgroundColor": {
			"type": "string",
			"default": ""
		},
		"backgroundImageUrl": {
			"type": "string",
			"default": ""
		},
		"backgroundSize": {
			"type": "string",
			"default": ""
		},
		"backgroundPosition": {
			"type": "string",
			"enum": [ "", "center", "top", "top right", "right", "bottom right", "bottom", "bottom left", "left", "top left" ],
			"default": ""
		},
		"backgroundRepeat": {
			"type": "string",
			"enum": [ "", "no-repeat", "repeat", "repeat-x", "repeat-y" ],
			"default": ""
		},
		"backgroundOpacity": {
			"type": "number"
		},
		"backgroundTransition": {
			"type": "string",
			"enum": [ "", "none", "fade", "slide", "convex", "concave", "zoom" ],
			"default": ""
		},
		"autoAnimate": {
			"type": "boolean",
			"default": false
		},
		"autoAnimateId": {
			"type": "string",
			"default": ""
		},
		"autoAnimateRestart": {
			"type": "boolean",
			"default": false
		},
		"fragmentContext": {
			"type": "boolean",
			"default": true
		}
	},
	"providesContext": {
		"presenter/insideSlide": "fragmentContext"
	},
	"supports": {
		"align": false,
		"anchor": false,
		"customClassName": false,
		"html": false,
		"reusable": false
	},
	"editorScript": "presenter-block-editor"
}
