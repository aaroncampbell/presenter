{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "presenter/slide",
	"title": "Slide",
	"category": "common",
	"icon": "slides",
	"description": "Add a slide to your presentation. Place any blocks inside it to build the slide's content.",
	"keywords": [ "presentation", "presenter", "slide", "reveal" ],
	"version": "2.0.0",
	"textdomain": "presenter",
	"attributes": {
		"title": {
			"type": "string"
		},
		"speakerNotes": {
			"type": "string"
		},
		"hidden": {
			"type": "boolean",
			"default": false
		},
		"bgColor": {
			"type": "string"
		},
		"bgImageId": {
			"type": "number"
		},
		"bgImageUrl": {
			"type": "string"
		},
		"bgVideoUrl": {
			"type": "string"
		},
		"transition": {
			"type": "string"
		},
		"autoAnimate": {
			"type": "boolean",
			"default": false
		},
		"extraClass": {
			"type": "string"
		},
		"extraData": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": false,
			"padding": true
		}
	},
	"example": {
		"attributes": {
			"title": "Slide Title"
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": { "content": "Slide Title", "level": 2 }
			},
			{
				"name": "core/paragraph",
				"attributes": { "content": "Your slide content goes here." }
			}
		]
	},
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./build/index.css",
	"render": "file:./render.php"
}
