{
	"name": "aaroncampbell/presenter",
	"description": "Create and present Reveal.js slide decks with the native WordPress block editor.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
		"ergebnis/composer-normalize": "^2.52",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"php-stubs/wordpress-stubs": "7.0.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpstan/phpstan": "^2.2.5",
		"phpunit/phpunit": "^9.6.29",
		"squizlabs/php_codesniffer": "^3.13.5",
		"wp-coding-standards/wpcs": "^3.4.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true
		},
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"check": [
			"@check:validate",
			"@check:normalize",
			"@lint",
			"@compat",
			"@phpstan"
		],
		"check:audit": "composer audit --locked",
		"check:normalize": "composer normalize --dry-run",
		"check:validate": "composer validate --strict",
		"compat": "phpcs --standard=phpcompat.xml.dist",
		"format:php": "phpcbf --standard=phpcs.xml.dist",
		"lint": "parallel-lint presenter.php includes templates tests/php tools/headless tools/migration tools/snapshot build",
		"phpcs": "phpcs --standard=phpcs.xml.dist",
		"phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
		"test": "phpunit --configuration=phpunit.xml.dist"
	}
}
