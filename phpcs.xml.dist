<?xml version="1.0"?>
<ruleset name="Presenter">
	<description>WordPress coding standards for all shipped Presenter PHP and development tooling.</description>

	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg name="extensions" value="php" />
	<arg value="sp" />

	<file>tests/php</file>
	<file>tools/headless</file>
	<file>tools/migration</file>
	<file>tools/snapshot</file>
	<file>includes</file>
	<file>presenter.php</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>tests/php/*Test.php</exclude-pattern>
		<!-- Retained WordPress.org bootstrap and public Presenter 1.x class. -->
		<exclude-pattern>presenter.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>tests/php/*Test.php</exclude-pattern>
	</rule>
	<rule ref="PEAR.NamingConventions.ValidClassName.StartWithCapital">
		<!-- Renaming the public presenter singleton would break integrations. -->
		<exclude-pattern>presenter.php</exclude-pattern>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<!-- The WordPress plugin bootstrap intentionally owns both legacy and modern factories. -->
		<exclude-pattern>presenter.php</exclude-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="7.0" />
	<config name="testVersion" value="8.3-" />
</ruleset>
