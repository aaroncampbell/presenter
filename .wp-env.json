{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/wordpress-7.0.1.zip",
	"phpVersion": "8.3",
	"plugins": [
		".",
		"https://github.com/aaroncampbell/aarondcampbell-presenter-themes/archive/869144441e1f8d459d89456cd537bff245e94b11.zip",
		"https://downloads.wordpress.org/plugin/plugin-check.2.0.0.zip"
	],
	"port": 8888,
	"testsPort": 8889,
	"env": {
		"tests": {
			"config": {
				"SCRIPT_DEBUG": false
			}
		}
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEVELOPMENT_MODE": "plugin",
		"DISALLOW_FILE_EDIT": true
	}
}
